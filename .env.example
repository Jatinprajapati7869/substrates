# Public (browser) — Firebase web app config (validated in src/integrations/firebase/config.ts)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: canonical site (documentation; auth redirect URLs use request origin)
# VITE_SITE_ORIGIN=https://substrates.app

# Server — Firebase Admin (getServerEnv firebaseAdmin)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM newlines as \n in one line, or a multiline value
FIREBASE_PRIVATE_KEY=

# Server — cron auth (getServerEnv cron)
CRON_SECRET=
# Optional rotation overlap
CRON_SECRET_PREVIOUS=

# Server — Lemon Squeezy (getServerEnv lemonsqueezy; see docs/specs/billing-lemonsqueezy.md)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=
LEMONSQUEEZY_VARIANT_ID_SECTIONS=
LEMONSQUEEZY_VARIANT_ID_SECTIONS_TEMPLATES=
LEMONSQUEEZY_VARIANT_ID_LIFETIME=

# Server — AI recommendations (getServerEnv openai; OPENAI_API_KEY optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — Sentry (no-op when unset; education plan via GitHub Student Pack)
SENTRY_DSN=
# Browser bundle (build-time)
VITE_SENTRY_DSN=
# Optional client release tag when not injected by the host
# VITE_VERCEL_GIT_COMMIT_SHA=
# VITE_SOURCE_VERSION=

# Deploy (read in vite.config.ts, not env.server.ts)
# Production (Heroku): node-server — set on Heroku config vars
NITRO_PRESET=node-server
PORT=8080
